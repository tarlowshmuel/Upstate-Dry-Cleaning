# ─── Backend (api-server) — required ─────────────────────────────────────────
# Postgres connection string. Use Neon, Supabase, or any managed Postgres.
# Format: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Random ~32-byte string. Generate once and keep it stable, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin dashboard login.
ADMIN_PASSWORD=

# Admin's mobile number in E.164 format. Customer-triggered admin-forwards
# (HELP "Other", etc.) text this number, rate-limited.
ADMIN_PHONE_NUMBER=+15555550100

# Twilio messaging credentials. Get these from console.twilio.com.
# The phone number must be the one customers will text.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555550199

# Route planning anchors — used to draw the pickup/delivery route map.
DRIVER_START_ADDRESS=
DRY_CLEANERS_ADDRESS=

# ─── Backend — optional ──────────────────────────────────────────────────────
# Comma-separated list of frontend URLs allowed to call the API. Leave unset
# when the frontend is served from the same origin as the API (e.g. on
# Replit). Set this when the frontend is on a separate host (Cloudflare
# Pages, Vercel, Netlify).
#   Example: CORS_ORIGIN=https://upstatedrycleaning.com,https://www.upstatedrycleaning.com
CORS_ORIGIN=

# Port the API binds to. Fly / Railway inject this automatically.
PORT=8080

# ─── Frontend (dashboard) — build-time only ──────────────────────────────────
# Full origin of the deployed API (no trailing slash, no /api suffix).
# Leave unset for same-origin Replit-style deploys.
#   Example: VITE_API_BASE_URL=https://api.upstatedrycleaning.com
VITE_API_BASE_URL=
